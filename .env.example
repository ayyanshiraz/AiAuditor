# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accounting_dev"

# NextAuth
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File storage (attachments). "local" stores under ./uploads for development.
# Set to "s3" and provide credentials below to use S3-compatible storage in production.
STORAGE_PROVIDER="local"
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
